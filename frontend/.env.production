# Frontend env cho BUILD PRODUCTION (Vercel / static hosting).
#
# FILE NÀY ĐƯỢC COMMIT — hợp lệ vì env frontend không chứa secret nào
# (mọi biến VITE_* nằm public trong bundle sau khi build). CẤM thêm token,
# password, API key vào đây (rule 04).
#
# Vite tự đọc file này khi chạy `vite build` (mode = production).
# Nhờ vậy KHÔNG cần khai Environment Variables trên dashboard Vercel.
#
# ⚠️ Giá trị dưới là PLACEHOLDER — sửa thành domain backend thật trước khi deploy.
# ⚠️ Sửa xong phải BUILD LẠI / redeploy: biến VITE_* nhúng lúc build.

# ── URL backend ────────────────────────────────────────────────────────────
# Phải là URL TUYỆT ĐỐI, có https, kết thúc bằng /api.
#
#   Phương án A (FE + BE cùng domain, Nginx serve cả hai):  /api
#   Phương án B (FE trên Vercel, BE trên VPS):              https://<domain-be>/api
#
# ⚠️ BẮT BUỘC https: trang Vercel chạy https, trình duyệt chặn cứng request
#    sang http:// (mixed content). Không dùng được http://<IP-VPS>:3001/api.
#    Chưa có domain cho backend? Dùng DuckDNS / nip.io + certbot —
#    xem DEPLOY-VPS-NO-DOCKER.md §17.1.
#
# Giá trị này phải khớp APP_BASE_URL trong backend/.env (+ hậu tố /api).
VITE_API_BASE_URL=https://CHANGE-ME.duckdns.org/api

# Production luôn gọi backend thật. Không bao giờ để true ở đây.
VITE_USE_MOCK=false
