# Frontend env — copy: cp .env.example .env
# Vite chỉ expose biến có tiền tố VITE_. CẤM để secret ở đây: mọi biến VITE_*
# bị nhúng thẳng vào bundle công khai sau khi build (rule 04).
#
# Ba file, ba vai trò:
#   .env              — máy dev, gitignored (file này là mẫu của nó)
#   .env.production   — build production, ĐƯỢC COMMIT (không có secret)
#   .env.example      — mẫu, committed
#
# Biến VITE_* nhúng lúc BUILD. Đổi giá trị ⇒ phải build/redeploy lại,
# restart server không có tác dụng.

# URL gốc của backend API (đã gồm prefix /api).
#   Dev  : để '/api' — dev server Vite proxy sang VITE_DEV_PROXY_TARGET.
#   Prod : URL tuyệt đối tới backend, vd https://api.example.com/api
VITE_API_BASE_URL=/api

# true = dùng dữ liệu mock (MockDataContext), không cần backend.
# false = gọi backend thật qua VITE_API_BASE_URL.
VITE_USE_MOCK=false

# CHỈ dùng cho dev server (vite.config.ts). Không đi vào bundle, không có tác
# dụng ở production. Đổi khi backend chạy port khác 3001.
VITE_DEV_PROXY_TARGET=http://localhost:3001
