node_modules/
dist/
coverage/

# Env — chỉ commit .env.example (rule 04)
.env
.env.local
.env.*.local

# Backend có secret ⇒ mọi biến thể .env.production đều KHÔNG commit,
# chỉ commit backend/.env.production.example làm mẫu.
backend/.env.production

# Ngoại lệ: frontend/.env.production ĐƯỢC commit — env frontend không chứa
# secret (biến VITE_* nằm public trong bundle), Vercel build đọc thẳng file này.
!frontend/.env.production

# Docker
docker/.env

.DS_Store
*.log
