# Backend env — MẪU CHO PRODUCTION (VPS, không Docker).
#
# CÁCH DÙNG trên VPS:
#   cp .env.production.example .env
#   chmod 600 .env
#   nano .env        # điền toàn bộ chỗ CHANGE-ME
#
# Đặt tên file thật là `.env` (không phải `.env.production`) — Nest đọc `.env`
# qua ConfigModule({ envFilePath: '.env' }). App VALIDATE env lúc boot: thiếu
# hoặc sai biến bắt buộc ⇒ crash ngay kèm log liệt kê lỗi, không chạy nửa vời.
#
# FILE MẪU NÀY ĐƯỢC COMMIT, `.env` và `.env.production` thì KHÔNG (có secret).
# Thêm/đổi/xoá key ⇒ cập nhật cả .env.example và file này trong cùng commit (rule 04).
#
# Hướng dẫn đầy đủ: ../DEPLOY-VPS-NO-DOCKER.md

# ── App ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_PREFIX=api
TZ_DISPLAY=Asia/Ho_Chi_Minh

# ── Database ────────────────────────────────────────────────────
# Postgres CÓ SẴN trên VPS ⇒ port chuẩn 5432 (không phải 55432 của Docker dev).
# Tạo role + DB riêng, không dùng chung DB với dự án khác — xem guide §4.
# Postgres 15+ nhớ: GRANT ALL ON SCHEMA public TO toolautofb;
DATABASE_URL=postgresql://toolautofb:CHANGE-ME-DB-PASSWORD@127.0.0.1:5432/tool_auto_fb?schema=public

# ── Redis / BullMQ ──────────────────────────────────────────────
# Redis DÙNG CHUNG với dự án khác ⇒ bắt buộc kiểm tra trước khi deploy:
#   redis-cli config get maxmemory-policy
# Không phải `noeviction` ⇒ PHẢI tách instance riêng (guide §1), nếu không
# Redis sẽ âm thầm evict job BullMQ ⇒ bài không đăng, không có log lỗi.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ⚠️ BA BIẾN DƯỚI ĐÂY CẦN PATCH CODE TRƯỚC KHI DÙNG (guide §2).
# Code hiện chỉ đọc REDIS_HOST + REDIS_PORT ⇒ Redis có requirepass sẽ báo
# `NOAUTH Authentication required`. Bỏ comment sau khi đã patch.
#REDIS_PASSWORD=CHANGE-ME-REDIS-PASSWORD
#REDIS_DB=3                       # DB index riêng, khác dự án đang dùng chung
#REDIS_KEY_PREFIX=tool-auto-fb    # prefix key BullMQ, thay mặc định 'bull'

# ── JWT ─────────────────────────────────────────────────────────
# Sinh MỚI cho production, tuyệt đối không dùng lại giá trị dev:
#   openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE-ME-openssl-rand-hex-48
JWT_REFRESH_SECRET=CHANGE-ME-openssl-rand-hex-48
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Mã hoá secret trong DB (token FB + service account Drive) ───
# 32 byte hex. Sinh: openssl rand -hex 32
#
# ⚠️ BACKUP KEY NÀY RA NGOÀI VPS (password manager), lưu TÁCH RIÊNG khỏi dump DB.
# Mất/đổi key ⇒ mọi access_token Facebook và Drive credential đã mã hoá
# AES-256-GCM không giải mã được nữa, phải nhập tay lại toàn bộ ở /settings.
TOKEN_ENCRYPTION_KEY=CHANGE-ME-openssl-rand-hex-32

# ── App URLs ────────────────────────────────────────────────────
# APP_BASE_URL: gốc BACKEND. Dùng dựng redirect_uri OAuth Google Drive:
#   {APP_BASE_URL}/{API_PREFIX}/settings/google-drive/oauth/callback
#   → phải đăng ký ĐÚNG chuỗi này ở Google Cloud Console, nếu không sẽ
#     redirect_uri_mismatch khi bấm "Kết nối Drive".
# WEB_BASE_URL: gốc FRONTEND. Dùng cho CORS + redirect browser sau OAuth.
#
# Phương án A — FE + BE cùng domain (Nginx serve cả hai):
#   APP_BASE_URL=https://tool.example.com
#   WEB_BASE_URL=https://tool.example.com
# Phương án B — FE trên Vercel, BE trên VPS: HAI GIÁ TRỊ KHÁC NHAU.
#   BE bắt buộc có https (mixed content) — xem guide §17.
APP_BASE_URL=https://CHANGE-ME.duckdns.org
WEB_BASE_URL=https://CHANGE-ME.vercel.app

# ── Google Drive ────────────────────────────────────────────────
# CHỈ LÀ FALLBACK BOOTSTRAP (ADR-014). Cấu hình thật nhập ở UI /settings và lưu
# trong bảng app_settings. Để trống cũng chạy được — vào /settings cấu hình sau.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
# Nhớ đồng bộ với client_max_body_size của Nginx (đặt dư, vd 320M).
MAX_UPLOAD_MB=500
# Tổng thời gian Node nhận trọn 1 request. Phải >= proxy_read_timeout của Nginx,
# nếu không Node cắt trước và Nginx trả 502/504 dù Nginx cấu hình rất rộng.
HTTP_REQUEST_TIMEOUT_MS=900000

# ── Meta Graph API ──────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0

# ── Auto-post ───────────────────────────────────────────────────
# true = bật cron đăng bài. Đặt false nếu muốn deploy thử mà chưa đăng thật.
# ⚠️ Cron chạy trong cùng process API (ADR-002) ⇒ PM2 phải instances:1 + fork.
#    Nhiều instance = nhiều tick cùng slot = đăng trùng lên Page thật.
AUTOPOST_ENABLED=true
MAX_POST_PER_SLOT=20

# ── Monitor ─────────────────────────────────────────────────────
# Job PUBLISHING lâu hơn ngần này phút ⇒ /queue cảnh báo "job kẹt".
# Chỉ cảnh báo, hệ thống không tự sửa trạng thái.
MONITOR_STUCK_MINUTES=15

# ── Đăng bài lên Facebook ────────────────────────────────────────
# Trần thời gian đẩy 1 file lên Graph (deadline TỔNG của request).
# Video: 180s cũ đòi >=14 Mbps liên tục mới đẩy nổi 300MB — không đạt thì job
# hỏng rồi retry, mỗi lần retry lại tải file từ Drive về.
FB_IMAGE_TIMEOUT_MS=60000
FB_VIDEO_TIMEOUT_MS=900000
# Video đi qua Resumable Upload API — số lần thử lại tối đa cho MỖI pha
# (start/transfer/finish) khi lỗi mạng/Graph thoáng qua.
FB_VIDEO_CHUNK_RETRIES=3

# ── Cache media ──────────────────────────────────────────────────
# Cùng 1 video phân bổ cho nhiều page ⇒ tải từ Drive 1 lần, dùng chung file này.
# Để trống = dùng thư mục tạm của hệ điều hành.
MEDIA_CACHE_DIR=
# Giữ file bao lâu sau khi job cuối dùng xong (ms).
MEDIA_CACHE_TTL_MS=600000

# ── Upload media qua hàng đợi (plan 23) ──────────────────────────
# Nơi giữ file đang chờ đẩy lên Drive. KHÁC MEDIA_CACHE_DIR — thư mục đó bị xoá
# sạch mỗi lần boot nên không dùng chung được. Để trống = thư mục tạm của OS.
# ⚠️ Trần đĩa tạm ≈ MEDIA_UPLOAD_MAX_PENDING_JOBS × file lớn nhất — đặt ở
#    partition còn đủ chỗ (20 × 500MB = 10GB với giá trị mặc định).
MEDIA_UPLOAD_TMP_DIR=
# Số file đẩy lên Drive đồng thời (RAM đỉnh ≈ giá trị này × file lớn nhất).
MEDIA_UPLOAD_CONCURRENCY=3
# Giữ file tạm + job đã kết thúc bao lâu trước khi dọn (ms) — đủ để bấm "Thử lại".
MEDIA_UPLOAD_JOB_RETENTION_MS=86400000
# Trần số job QUEUED/UPLOADING_TO_DRIVE cùng lúc trên TOÀN hệ thống.
MEDIA_UPLOAD_MAX_PENDING_JOBS=20

# ── Nhập bài từ link Google Drive (plan 24) ──────────────────────────────
# Copy chạy PHÍA SERVER của Google (files.copy) — không byte nào của file đi
# qua backend, nên để song song cao hơn MEDIA_UPLOAD_CONCURRENCY được.
DRIVE_IMPORT_CONCURRENCY=5
# Trần số link nhận trong MỘT lần dán/một request.
DRIVE_IMPORT_MAX_LINKS_PER_REQUEST=50

# ── Seed tài khoản Quản trị cấp cao (plan 26) ────────────────────────────
# CHỈ dùng cho `npm run seed`. Không đi qua validateEnv (seed.ts là script
# đứng riêng, không phải app Nest) — thiếu thì seed DỪNG có thông báo, chứ
# không tạo user với mật khẩu mặc định.
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Super Admin

# ── Reup: cầu nối tới ai-video-downloader (plan 28) ──────────────────────
# NGOẠI LỆ CÓ CHỦ ĐÍCH so với rule 04: 4 biến dưới đây đều OPTIONAL và KHÔNG
# được validate lúc boot. `ai-video-downloader` là phụ thuộc TUỲ CHỌN — máy chưa
# cài Python/chưa clone downloader vẫn phải chạy đủ mọi tính năng còn lại.
# Thiếu ⇒ app vẫn boot, chỉ riêng tính năng reup ngưng (reup_runs sẽ ghi
# SKIPPED / DOWNLOADER_UNAVAILABLE và UI hiện banner).
#
# Đây chỉ là ĐƯỜNG DẪN, không phải secret. API key YouTube nằm trong DB
# (app_settings['youtube_api'], mã hoá AES-256-GCM) và sửa ở màn Reup Setting.
REUP_PYTHON_BIN=
REUP_PROJECT_DIR=
# Nơi để file .mp4 tạm trước khi đẩy lên Drive. Để trống = thư mục tạm của OS.
# Tách riêng khỏi MEDIA_CACHE_DIR (bị xoá mỗi lần boot) và MEDIA_UPLOAD_TMP_DIR.
REUP_TMP_DIR=
# Trần thời gian tải MỘT video. Quá hạn ⇒ giết cả cây process (kể cả yt-dlp).
REUP_DOWNLOAD_TIMEOUT_MS=600000

# api GG CLoud console API YOUTOBE V3
API_GG_CLOUD_YOUTOBE_V3=