// Nguồn sự thật của DB. Mọi thay đổi ở đây PHẢI cập nhật ../../erd.md (rule 05).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Prisma 7: connection URL khai báo ở ../prisma.config.ts, không đặt `url` ở đây.
datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
  CONTENT
}

enum MediaType {
  image
  video
}

enum SlotMediaType {
  image
  video
  all
}

enum ContentStatus {
  PENDING_REVIEW // Chờ duyệt (mặc định sau upload)
  APPROVED // Đã duyệt — pool cho Bot lấy đăng
  REJECTED // Không duyệt — bắt buộc reject_comment
  PUBLISHING // Đang đăng — chỉ Bot set
  PUBLISHED // Đã đăng (>= 1 page) — chỉ Bot set
}

enum PublishStatus {
  SCHEDULED
  QUEUED
  PUBLISHING
  SUCCESS
  FAILED
  CANCELLED
}

/// Kết quả một lần cron chạm một slot (plan 07 §4.3).
enum SlotRunStatus {
  CLAIMED // đã giành quyền chạy, chưa đóng sổ
  DONE // đã tạo job
  SKIPPED // không tạo job nào, lý do ở skip_reason
  ERROR // hỏng giữa chừng, lý do ở error_message
}

/// Nhật ký kỹ thuật từng lần thử đăng của một publish job (plan 07 §4.3).
enum PublishJobEventType {
  ENQUEUED
  STARTED
  SUCCEEDED
  FAILED
  RETRY_SCHEDULED
  GAVE_UP
}

/// Vòng đời một lần "Upload Ảnh/Video" từ UI (plan 23). File đã nằm trên đĩa
/// server, phần đẩy lên Drive + tạo `content_assets` chạy nền qua BullMQ.
enum MediaUploadStatus {
  QUEUED
  UPLOADING_TO_DRIVE
  /// Plan 24: đang gọi `files.copy` từ Drive nguồn (không byte nào qua server).
  COPYING_FROM_DRIVE
  SUCCESS
  FAILED
}

/// Nguồn của một job media (plan 24). Quyết định worker nào xử lý và job có
/// chiếm đĩa tạm hay không — `MediaUploadLimitGuard` chỉ đếm `LOCAL_FILE`.
enum MediaUploadSource {
  LOCAL_FILE
  DRIVE_LINK
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(CONTENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  contentCreated  ContentAsset[] @relation("ContentCreator")
  contentApproved ContentAsset[] @relation("ContentApprover")
  contentUpdated  ContentAsset[] @relation("ContentUpdater")
  contentEdited   ContentAsset[] @relation("ContentEditor")
  auditLogs       AuditLog[]
  facebookPages   FacebookPage[]
  appSettings     AppSetting[]
  fbConnections   FacebookConnection[]
  mediaUploadJobs MediaUploadJob[]

  @@map("users")
}

/// Nguồn Page Access Token của một page (plan 15).
enum FacebookConnectMode {
  MANUAL_TOKEN // dán tay ở form (thường là token System User doanh nghiệp cấp)
  FB_LOGIN // lấy tự động qua đăng nhập Facebook
}

/// Một lần đăng nhập Facebook = một dòng. Giữ long-lived user token (~60 ngày)
/// để còn đồng bộ page mới và lấy lại Page token mà không bắt đăng nhập lại.
model FacebookConnection {
  id            String    @id @default(uuid()) @db.Uuid
  fbUserId      String    @unique @map("fb_user_id")
  fbUserName    String?   @map("fb_user_name")
  userTokenEnc  String?   @map("user_token_enc") @db.Text // null = đã ngắt kết nối
  tokenExpireAt DateTime? @map("token_expire_at") // null = không hết hạn
  scopes        String[]  @map("scopes")
  revokedAt     DateTime? @map("revoked_at")
  connectedById String    @map("connected_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  connectedBy User           @relation(fields: [connectedById], references: [id])
  pages       FacebookPage[]

  @@index([revokedAt])
  @@map("facebook_connections")
}

model FacebookPage {
  id              String    @id @default(uuid()) @db.Uuid
  pageName        String    @map("page_name")
  pageId          String    @unique @map("page_id")
  accessTokenEnc  String    @map("access_token_enc") @db.Text
  tokenExpireAt   DateTime? @map("token_expire_at")
  isActive        Boolean   @default(true) @map("is_active") // tạm dừng page (vẫn hiện ở UI)
  autopostEnabled Boolean   @default(false) @map("autopost_enabled")
  deletedAt       DateTime? @map("deleted_at") // != null = đã xoá, ẩn khỏi mọi truy vấn nghiệp vụ
  createdById     String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  connectMode  FacebookConnectMode @default(MANUAL_TOKEN) @map("connect_mode")
  connectionId String?             @map("connection_id") @db.Uuid // null = token dán tay

  connection    FacebookConnection?     @relation(fields: [connectionId], references: [id])
  createdBy     User                    @relation(fields: [createdById], references: [id])
  publishJobs   PublishJob[]
  assignments   ContentPageAssignment[]
  autoPostSlots AutoPostSlot[]

  @@index([isActive])
  @@index([deletedAt])
  @@index([connectionId])
  @@map("facebook_pages")
}

model ContentAsset {
  id            String        @id @default(uuid()) @db.Uuid
  title         String
  description   String?       @db.Text
  caption       String        @db.Text // Bot dùng khi đăng
  hashtags      String?       @db.Text
  category      String // "Dạng" bài
  mediaType     MediaType     @map("media_type")
  driveFileId   String        @map("drive_file_id")
  driveUrl      String?       @map("drive_url")
  thumbnailUrl  String?       @map("thumbnail_url")
  mimeType      String?       @map("mime_type")
  fileSize      BigInt?       @map("file_size")
  /// Plan 24: fileId GỐC bên Drive người khác khi bài được nhập bằng link
  /// (`drive_file_id` là bản copy trong folder tool). null = upload từ máy.
  sourceDriveFileId String?   @map("source_drive_file_id")
  status        ContentStatus @default(PENDING_REVIEW)
  isAds         Boolean       @default(false) @map("is_ads") // Đạt ADS
  isActive      Boolean       @default(true) @map("is_active") // false = ngưng dùng: Bot không lấy nữa (khác status duyệt)
  rejectComment String?       @map("reject_comment") @db.Text
  createdById   String        @map("created_by") @db.Uuid
  approvedById  String?       @map("approved_by") @db.Uuid
  updatedById   String?       @map("updated_by") @db.Uuid // người sửa gần nhất; null = bài cũ trước khi có tracking
  editorId      String?       @map("editor_id") @db.Uuid // người DỰNG video/ảnh (role EDITOR); khác người upload
  createdAt     DateTime      @default(now()) @map("created_at") // Ngày upload
  updatedAt     DateTime      @updatedAt @map("updated_at") // Mốc xếp hàng cho Bot

  createdBy   User                    @relation("ContentCreator", fields: [createdById], references: [id])
  approvedBy  User?                   @relation("ContentApprover", fields: [approvedById], references: [id])
  updatedBy   User?                   @relation("ContentUpdater", fields: [updatedById], references: [id])
  editor      User?                   @relation("ContentEditor", fields: [editorId], references: [id])
  publishJobs     PublishJob[]
  assignments     ContentPageAssignment[]
  extraFiles      ContentAssetFile[] // ảnh phụ của bài nhiều ảnh (plan 22)
  mediaUploadJobs MediaUploadJob[] // job upload đã sinh ra bài này (plan 23)

  @@index([status])
  @@index([editorId]) // filter "Editor" trên màn Quản lý Ảnh/Video
  @@index([category])
  @@index([mediaType])
  @@index([createdById])
  @@index([isAds])
  @@index([isActive])
  @@index([sourceDriveFileId]) // Cảnh báo "link này đã nhập rồi" (plan 24)
  @@index([status, isActive, updatedAt]) // Cron picker: APPROVED + đang dùng, order by updated_at ASC
  @@map("content_assets")
}

/// Ảnh **phụ** của một bài nhiều ảnh (plan 22). Ảnh đầu tiên vẫn là chính
/// `content_assets.drive_file_id` (vị trí 0) nên bảng này chỉ chứa `position >= 1`
/// — record 1 ảnh (dữ liệu cũ) không cần backfill, mọi query cũ không phải sửa.
/// Danh sách ảnh được cố định lúc upload; muốn đổi thì xoá record và upload lại.
model ContentAssetFile {
  id             String   @id @default(uuid()) @db.Uuid
  contentAssetId String   @map("content_asset_id") @db.Uuid
  position       Int
  driveFileId    String   @map("drive_file_id")
  driveUrl       String?  @map("drive_url")
  thumbnailUrl   String?  @map("thumbnail_url")
  mimeType       String?  @map("mime_type")
  fileSize       BigInt?  @map("file_size")
  createdAt      DateTime @default(now()) @map("created_at")

  contentAsset ContentAsset @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)

  @@unique([contentAssetId, position])
  @@index([contentAssetId])
  @@map("content_asset_files")
}

/// Một lần bấm "Upload" ở màn Quản lý Ảnh/Video = một dòng (plan 23). Trình duyệt
/// chỉ đẩy file lên **server**; phần đẩy Drive + tạo `content_assets` do worker
/// `media-upload` làm sau, nên file phải nằm tạm trên đĩa ngoài vòng đời request.
///
/// `files` = mảng JSON `[{ originalFilename, mimeType, size, tempPath }]` theo đúng
/// thứ tự đăng (phần tử 0 = ảnh đại diện). Bài nhiều ảnh ⇒ N file trong **một** job.
/// `metadata` = form lúc submit `{ title, category, caption, hashtags, assignedPageIds, editorId }`.
model MediaUploadJob {
  id               String            @id @default(uuid()) @db.Uuid
  status           MediaUploadStatus @default(QUEUED)
  source           MediaUploadSource @default(LOCAL_FILE)
  originalFilename String            @map("original_filename") // file đầu tiên — chỉ để hiện trên UI
  fileCount        Int               @map("file_count")
  totalSize        BigInt            @map("total_size")
  files            Json
  metadata         Json
  errorMessage     String?           @map("error_message") @db.Text
  attemptCount     Int               @default(0) @map("attempt_count")
  bullJobId        String?           @map("bull_job_id")
  /// != null = file tạm đã bị xoá ⇒ không "Thử lại" được nữa.
  filesRemovedAt   DateTime?         @map("files_removed_at")
  contentAssetId   String?           @map("content_asset_id") @db.Uuid
  createdById      String            @map("created_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  contentAsset ContentAsset? @relation(fields: [contentAssetId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id])

  @@index([status]) // Cron dọn job đã kết thúc
  @@index([source, status]) // Guard chỉ đếm job LOCAL_FILE đang chiếm đĩa (plan 24)
  @@index([createdById, status]) // FE poll "job upload của tôi"
  @@map("media_upload_jobs")
}

/// Phân bổ content -> page. publishedAt != null nghĩa là ĐÃ đăng trên page đó.
/// UNIQUE(content, page) enforce rule "mỗi bài chỉ đăng 1 lần / 1 page".
model ContentPageAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  contentAssetId String    @map("content_asset_id") @db.Uuid
  facebookPageId String    @map("facebook_page_id") @db.Uuid
  publishedAt    DateTime? @map("published_at")
  facebookPostId String?   @map("facebook_post_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  contentAsset ContentAsset @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  facebookPage FacebookPage @relation(fields: [facebookPageId], references: [id])

  insight          PostInsight?
  insightSnapshots PostInsightSnapshot[]

  @@unique([contentAssetId, facebookPageId])
  @@index([facebookPageId, publishedAt])
  @@map("content_page_assignments")
}

/// Số liệu Facebook Insights MỚI NHẤT của một bài đã đăng (plan 25).
///
/// Neo vào assignment chứ không vào `publish_jobs`: assignment có
/// UNIQUE(content, page) nên không bao giờ trùng, còn 1 content retry nhiều lần
/// sinh nhiều publish_job ⇒ đếm view sẽ nhân đôi.
///
/// **Mọi cột số đều NULLABLE và không có default** (sửa 2026-08-08 sau khi đo
/// Graph thật): `NULL` = chưa đo được chỉ số đó, `0` = đã đo và thật sự bằng 0.
/// Cột NOT NULL DEFAULT 0 làm hai chuyện đó thành một, và đó chính là lý do màn
/// hình từng hiện "0 lượt xem" cho bài chưa hề lấy được số.
///
/// **Không có cột impressions/reach tổng:** Meta đã gỡ toàn bộ họ
/// `post_impressions*` / `post_reach` khỏi Graph API (kiểm chứng 2026-08-08 trên
/// v19→v23: đều trả `(#100) The value must be a valid insights metric`).
model PostInsight {
  id               String    @id @default(uuid()) @db.Uuid
  assignmentId     String    @unique @map("assignment_id") @db.Uuid
  facebookPostId   String    @map("facebook_post_id")
  /// `post_video_views` — chỉ bài video mới có.
  videoViews       Int?      @map("video_views")
  /// `post_fan_reach` — số người theo dõi page đã thấy bài. KHÔNG phải reach tổng.
  fanReach         Int?      @map("fan_reach")
  /// `post_clicks` — lượt nhấp vào bài (ảnh, link, xem thêm...).
  clicks           Int?
  likeCount        Int?      @map("like_count")
  commentCount     Int?      @map("comment_count")
  shareCount       Int?      @map("share_count")
  /// Lần đồng bộ THÀNH CÔNG gần nhất. `null` = chưa lần nào lấy được số (dòng có
  /// thể đã tồn tại chỉ để ghi `sync_error_message`).
  fetchedAt        DateTime? @map("fetched_at")
  /// != null = Graph khẳng định bài không còn tồn tại ⇒ NGỪNG đồng bộ.
  /// Chỉ được set khi Graph trả `error_subcode = 33`; **cấm** suy ra từ code 100
  /// trần — Graph dùng code 100 cho cả "tên metric sai", và đánh dấu nhầm sẽ giết
  /// việc theo dõi một bài đang sống mà không ai biết.
  missingOnFbAt    DateTime? @map("missing_on_fb_at")
  syncErrorMessage String?   @map("sync_error_message") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  assignment ContentPageAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([facebookPostId])
  @@map("post_insights")
}

/// Ảnh chụp số liệu mỗi ngày — để xem xu hướng và biết bài đã "nguội" chưa.
/// UNIQUE(assignment, date) làm job chạy 4 lần/ngày vẫn chỉ để lại 1 dòng.
model PostInsightSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  /// 'YYYY-MM-DD' theo Asia/Ho_Chi_Minh — cùng quy ước với `slot_runs.run_date`.
  snapshotDate String   @map("snapshot_date")
  videoViews   Int?     @map("video_views")
  fanReach     Int?     @map("fan_reach")
  clicks       Int?
  createdAt    DateTime @default(now()) @map("created_at")

  assignment ContentPageAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, snapshotDate])
  @@map("post_insight_snapshots")
}

/// Mốc giờ đăng tự động của từng page — config 1 lần, lặp lại mỗi ngày.
/// `time` là chuỗi 'HH:mm' hiểu theo Asia/Ho_Chi_Minh, KHÔNG phải timestamp.
model AutoPostSlot {
  id             String        @id @default(uuid()) @db.Uuid
  facebookPageId String        @map("facebook_page_id") @db.Uuid
  time           String
  categories     String[]
  mediaType      SlotMediaType @default(all) @map("media_type")
  postCount      Int           @default(1) @map("post_count")
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  facebookPage FacebookPage @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)
  slotRuns     SlotRun[]

  @@index([facebookPageId, enabled])
  @@map("auto_post_slots")
}

/// Chống cron double-fire (ADR-006) **và** nhật ký mỗi lần cron chạm slot (plan 07 §4.3).
/// Cùng một hàng: INSERT để giành quyền chạy, UPDATE để đóng sổ kết quả — không tách
/// bảng log riêng để khỏi có 2 đường ghi lệch nhau.
model SlotRun {
  id              String        @id @default(uuid()) @db.Uuid
  slotId          String        @map("slot_id") @db.Uuid
  runDate         String        @map("run_date") // 'YYYY-MM-DD' theo Asia/Ho_Chi_Minh
  runTime         String        @map("run_time") // 'HH:mm'
  status          SlotRunStatus @default(CLAIMED)
  pickedCount     Int           @default(0) @map("picked_count")
  jobCreatedCount Int           @default(0) @map("job_created_count")
  skipReason      String?       @map("skip_reason") // NO_CONTENT | PAGE_PAUSED | TOKEN_MISSING...
  startedAt       DateTime      @default(now()) @map("started_at")
  finishedAt      DateTime?     @map("finished_at")
  errorMessage    String?       @map("error_message") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")

  slot AutoPostSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([slotId, runDate, runTime])
  @@index([runDate, status])
  @@map("slot_runs")
}

model PublishJob {
  id             String        @id @default(uuid()) @db.Uuid
  contentAssetId String        @map("content_asset_id") @db.Uuid
  facebookPageId String        @map("facebook_page_id") @db.Uuid
  caption        String        @db.Text
  hashtags       String?       @db.Text
  scheduleTime   DateTime      @map("schedule_time")
  status         PublishStatus @default(QUEUED)
  publishedAt    DateTime?     @map("published_at")
  facebookPostId String?       @map("facebook_post_id")
  errorMessage   String?       @map("error_message") @db.Text
  attemptCount   Int           @default(0) @map("attempt_count")
  bullJobId      String?       @map("bull_job_id")
  createdBy      String        @default("Bot") @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  contentAsset ContentAsset       @relation(fields: [contentAssetId], references: [id])
  facebookPage FacebookPage       @relation(fields: [facebookPageId], references: [id])
  events       PublishJobEvent[]

  @@index([status])
  @@index([scheduleTime])
  @@index([contentAssetId, facebookPageId])
  @@map("publish_jobs")
}

/// Nhật ký kỹ thuật của publish job: mỗi lần thử đăng ghi lại đã tới bước nào,
/// hỏng vì sao. Khác `audit_logs` (dấu vết nghiệp vụ, ai làm gì).
/// `raw_error` PHẢI đi qua hàm lọc trước khi ghi — không được chứa access token.
model PublishJobEvent {
  id           String              @id @default(uuid()) @db.Uuid
  publishJobId String              @map("publish_job_id") @db.Uuid
  attemptNo    Int                 @map("attempt_no")
  event        PublishJobEventType
  message      String?             @db.Text
  rawError     Json?               @map("raw_error")
  createdAt    DateTime            @default(now()) @map("created_at")

  publishJob PublishJob @relation(fields: [publishJobId], references: [id], onDelete: Cascade)

  @@index([publishJobId, createdAt])
  @@map("publish_job_events")
}

/// Cấu hình động sửa được từ UI "Cài đặt chung" (ADR-014).
/// 1 dòng = 1 nhóm config, `value` là JSONB nên thêm nhóm mới không cần migration.
/// Secret bên trong `value` đã mã hoá AES-256-GCM — KHÔNG bao giờ trả thô ra API.
model AppSetting {
  key         String   @id // 'google_drive' | 'facebook' | 'system'
  value       Json
  updatedById String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("app_settings")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid // null = Bot/system
  action      String
  resource    String
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
